# ── Browser: Firebase web config ─────────────────────────────────────────────
# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration.
# Public identifiers, not secrets; access is enforced by firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# true → talk to the local Emulator Suite (npm run emulators) instead of the real project.
NEXT_PUBLIC_USE_EMULATORS=false

# true → also offer "sign in with an email link" (enable Email link in Firebase Auth first;
# Spark sends at most 5 of these emails a day). Google sign-in is always on.
NEXT_PUBLIC_EMAIL_SIGN_IN=false

# ── Server (route handlers on Vercel). SECRETS: set them in Vercel, never commit them. ──
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON file (or its base64). Not needed with the emulators.
FIREBASE_SERVICE_ACCOUNT=

# Added automatically when you connect a Blob store to the Vercel project.
# Without it, local dev stores previews in .blobs/ (emulator mode only).
BLOB_READ_WRITE_TOKEN=

# Who may use the server (link previews, uploads). Comma-separated; empty = anyone signed in.
ILHAM_ALLOWED_EMAILS=

# true → never call Microlink for pages we can't read ourselves.
MICROLINK_DISABLED=false
