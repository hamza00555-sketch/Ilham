{
  "name": "ilham",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emulators": "NEXT_PUBLIC_USE_EMULATORS=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && npm --prefix functions run typecheck",
    "test": "vitest run",
    "emulators": "npm --prefix functions run build && npx -y firebase-tools@15 emulators:start",
    "deploy:firebase": "npx -y firebase-tools@15 deploy --only firestore,storage,functions"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.4.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
